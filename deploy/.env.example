# Copy to deploy/.env; never commit the actual .env.
# Point public DNS A/AAAA to a server that can run the Python model.
VOXSHIFT_DOMAIN=voice.example.com
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
VOXSHIFT_API_KEY=REPLACE_WITH_A_RANDOM_32_PLUS_CHARACTER_SECRET
VOXSHIFT_DEVICE=cpu
# For NVIDIA hosts replace CPU wheel index and add GPU compose override.
VOXSHIFT_TORCH_INDEX=https://download.pytorch.org/whl/cpu
